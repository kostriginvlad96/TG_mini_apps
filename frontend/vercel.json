{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://your-backend-url.vercel.app",
    "VITE_TELEGRAM_BOT_USERNAME": "@your_bot_username",
    "VITE_APP_URL": "https://your-app-url.vercel.app"
  }
}
